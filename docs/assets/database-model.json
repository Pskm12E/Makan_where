  "view": {
    "name": "catalogue_menu_summary",
    "query": "SELECT p.place_id, p.place_name, COUNT(d.dish_id) AS available_dishes,\nMIN(d.price) AS starting_price, AVG(d.price) AS average_price\nFROM food_place p LEFT JOIN dish d ON d.place_id = p.place_id AND d.is_available = 1\nWHERE p.archived_at IS NULL GROUP BY p.place_id, p.place_name"
  },
  "mongo_validators": {
    "content": {
      "$and": [
        {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "_id",
              "kind",
              "author_id",
              "place_id",
              "body",
              "created_at",
              "updated_at",
              "removed_at",
              "dishes"
            ],
            "properties": {
              "_id": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 1
              },
              "author_id": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 1
              },
              "place_id": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "review",
                  "thread",
                  "comment"
                ]
              },
              "body": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "title": {
                "bsonType": "string",
                "maxLength": 150
              },
              "rating": {
                "bsonType": "int",
                "minimum": 1,
                "maximum": 5
              },
              "thread_id": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 1
              },
              "created_at": {
                "bsonType": "date"
              },
              "updated_at": {
                "bsonType": "date"
              },
              "removed_at": {
                "bsonType": [
                  "date",
                  "null"
                ]
              },
              "removed_by_id": {
                "bsonType": [
                  "int",
                  "long",
                  "null"
                ]
              },
              "is_demo": {
                "bsonType": "bool"
              },
              "dishes": {
                "bsonType": "array",
                "maxItems": 20,
                "items": {
                  "bsonType": "object",
                  "required": [
                    "dish_id",
                    "feedback"
                  ],
                  "properties": {
                    "dish_id": {
                      "bsonType": [
                        "int",
                        "long"
                      ],
                      "minimum": 1
                    },
                    "feedback": {
                      "bsonType": [
                        "string",
                        "null"
                      ],
                      "maxLength": 1000
                    }
                  }
                }
              }
            },
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "review"
                    ]
                  }
                },
                "required": [
                  "rating",
                  "title"
                ],
                "not": {
                  "required": [
                    "thread_id"
                  ]
                }
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "thread"
                    ]
                  }
                },
                "required": [
                  "title"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "rating"
                      ]
                    },
                    {
                      "required": [
                        "thread_id"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "comment"
                    ]
                  }
                },
                "required": [
                  "thread_id"
                ],
                "not": {
                  "required": [
                    "rating"
                  ]
                }
              }
            ]
          }
        },
        {
          "$or": [
            {
              "removed_at": null,
              "removed_by_id": null
            },
            {
              "removed_at": {
                "$type": "date"
              },
              "removed_by_id": {
                "$type": [
                  "int",
                  "long"
                ]
              }
            }
          ]
        }
      ]
    },
    "upvotes": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
