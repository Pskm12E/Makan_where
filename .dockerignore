# An allowlist keeps private config, databases, archives and reports out of images.
**
!Dockerfile
!backend/
!backend/*.py
!backend/requirements.txt
!database/
!database/*.py
!database/*.json
!database/*.js
!database/*.sql
!data/
!data/**
!assets/
!assets/**
!css/
!css/*.css
!js/
!js/*.js
!scripts/
!scripts/*.py
!tests/
!tests/*.py
!deploy/
!deploy/*.py
!*.html
!pytest.ini
**/__pycache__/
**/*.pyc
**/.env*
