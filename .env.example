# Export using your shell or service manager; no dotenv loader.
# Generate a random SECRET_KEY of at least 32 characters. Never commit it.
SECRET_KEY=
PASSWORD_PEPPER=
MONGODB_URI=mongodb://APP_USER:APP_PASSWORD@127.0.0.1:27017/makanwhere?authSource=makanwhere
MONGODB_DATABASE=makanwhere
DATABASE_URL=mysql+pymysql://APP_USER:APP_PASSWORD@127.0.0.1/makanwhere?charset=utf8mb4
COOKIE_SECURE=true
TRUST_PROXY=false
TRUSTED_HOSTS=makanwhere.4bytedigi.com,localhost,127.0.0.1
SAMPLE_CATALOGUE=true
RATELIMIT_STORAGE_URI=memory://
# Optional server-to-server menu import key, at least 32 random characters.
# Leave unset to disable bearer-key imports; admin session imports still work.
# This authenticates YOUR import API; it is not a restaurant-data subscription.
MENU_IMPORT_API_KEY=
